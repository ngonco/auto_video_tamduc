# GROQ STT (ưu tiên đầu tiên, gọi trực tiếp https://api.groq.com/openai/v1/audio/transcriptions)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# CẤU HÌNH API VILAO.AI (STT dự phòng; sửa phụ đề & Vision giữ nguyên)
VILAO_STT_KEY=sk-...
VILAO_SUBTITLE_KEY=sk-...
VILAO_EMBEDDING_KEY=sk-...
VILAO_API_KEY=
VILAO_BASE_URL=https://api.vilao.ai/v1

# TÊN CÁC MODEL AI
STT_MODEL=tsa/groq/whisper-large-v3
# Các model Vilao sau STT_MODEL; để trống chỉ tắt các model Vilao bổ sung
STT_FALLBACK_MODELS=tsa/groq/whisper-large-v3-turbo,bh2/faster-whisper-chat,tsa/gemini/gemini-2.5-flash,tsa/gemini/gemini-2.5-flash-lite
STT_REQUEST_TIMEOUT_MS=60000
SUBTITLE_FIX_MODEL=ts/gemini-3.1-flash-lite
VISION_MODEL=ts/gemini-3.1-flash-lite
EMBEDDING_MODEL=emb/text-embedding-3-large

# ĐƯỜNG DẪN THƯ MỤC CỤC BỘ
ROOT_SOURCE_DIR=E:/Thanh Vi/PAGE Không gian thờ/Source Video
EXPORT_DIR=d:/DONG GOI TAM THOI/Auto_Video_TamDuc/exports

# CẤU HÌNH SERVER
PORT=3001
